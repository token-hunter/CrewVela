{
  "name": "crewvela",
  "private": true,
  "version": "0.1.1-beta.20261127",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "node scripts/tauri-cli.mjs build --no-bundle --features custom-protocol",
    "build:macos": "node scripts/tauri-cli.mjs build --target aarch64-apple-darwin --features custom-protocol --bundles app,dmg",
    "bundle:windows": "tauri bundle --bundles nsis",
    "test:desktop-assets": "cargo test --manifest-path src-tauri/Cargo.toml --features custom-protocol --test packaged_assets -- --ignored",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "test": "node --test --test-timeout=120000 tests/*.test.cjs tests/*.test.mjs tests/*.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.63.0",
    "@agentclientprotocol/codex-acp": "1.11.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/mcp": "0.0.83",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "^5.6.3",
    "vite": "6.4.6"
  }
}
